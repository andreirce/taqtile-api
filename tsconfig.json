{
  "compilerOptions": {
    "target": "es2021",                                  
    "experimentalDecorators": true,                   
    "emitDecoratorMetadata": true,                    
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,                                      
    "strictNullChecks": false,                       
    "skipLibCheck": true,
    "paths": {
      "@core": ["./core"],
      "@core/": ["./core/*"],
      "@data": ["./data"],
      "@data/": ["./data/*"],
      "@domain": ["./domain"],
      "@domain/": ["./domain/*"],
      "@graphql": ["./api/graphql"],
      "@graphql/": ["./api/graphql/*"],
      "@test": ["./test*"],
      "@test/": ["./test/*"],
    }
  }
}
